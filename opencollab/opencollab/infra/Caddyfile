# Development — replace yourdomain.com for production
:80 {
  # Frontend
  handle /* {
    reverse_proxy frontend:5173
  }

  # Backend API
  handle /api/* {
    reverse_proxy backend:3001
  }

  # WebSocket
  handle /socket.io/* {
    reverse_proxy backend:3001
  }

  # Gitea
  handle /git/* {
    uri strip_prefix /git
    reverse_proxy gitea:3000
  }
}
